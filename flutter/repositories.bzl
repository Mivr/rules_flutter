def _flutter_patched_sdk_product_repo_impl(repository_ctx):
    if getattr(repository_ctx.attr, "local_path", ""):
        sdk = resolve_local_sdk_root(repository_ctx, getattr(repository_ctx.attr, "local_path", ""))
        link_local_dir(
            repository_ctx,
            sdk,
            "bin/cache/artifacts/engine/common/flutter_patched_sdk_product",
            "patched-sdk-product/flutter_patched_sdk_product",
            "patched SDK (product)",
        )
        _write_patched_sdk_product_build(repository_ctx)
        return
    url = engine_artifact_url(
        repository_ctx.attr.engine_revision,
        "flutter_patched_sdk_product.zip",
        getattr(repository_ctx.attr, "engine_base_url", ""),
    )
    pinned_download_and_extract(
        repository_ctx,
        url = url,
        sha256 = require_sha256(repository_ctx.attr.sha256, url),
        output = "patched-sdk-product",
    )
    _write_patched_sdk_product_build(repository_ctx)

def _write_patched_sdk_product_build(repository_ctx):
    repository_ctx.file("BUILD.bazel", """# Generated by flutter/repositories.bzl
filegroup(
    name = "patched_sdk_product",
    srcs = glob(["patched-sdk-product/flutter_patched_sdk_product/**"]),
    visibility = ["//visibility:public"],
)

exports_files(glob(["**"]), visibility = ["//visibility:public"])
""")

flutter_patched_sdk_product_repo = repository_rule(
    _flutter_patched_sdk_product_repo_impl,
    doc = "Lazily downloads the product Flutter patched SDK (platform_strong.dill for release/profile builds).",
    attrs = {
        "engine_revision": attr.string(
            doc = "The engine commit hash. Empty means a local SDK (with `local_path`).",
            default = "",
        ),
        "sha256": attr.string(
            doc = "Expected SHA-256 of the archive. Empty means a local SDK (with `local_path`).",
            default = "",
        ),
        "local_path": attr.string(
            doc = "Optional path to a pre-extracted Flutter SDK " +
                  "(bin/cache layout) to source every artifact from instead " +
                  "of the network. Mutually exclusive with downloading.",
            default = "",
        ),
        "engine_base_url": attr.string(
            doc = "Optional replacement origin for the engine revision " +
                  "directory (an enterprise build). Empty means the default GCS base.",
            default = "",
        ),
    },
)

def _flutter_material_fonts_repo_impl(repository_ctx):
    if getattr(repository_ctx.attr, "local_path", ""):
        sdk = resolve_local_sdk_root(repository_ctx, getattr(repository_ctx.attr, "local_path", ""))
        link_local_dir(
            repository_ctx,
            sdk,
            "bin/cache/artifacts/material_fonts",
            "material-fonts",
            "material design fonts",
        )
        _write_material_fonts_build(repository_ctx)
        return
    fonts_path = repository_ctx.attr.material_fonts_url
    if fonts_path.startswith("https://"):
        url = fonts_path
    else:
        url = "https://storage.googleapis.com/" + fonts_path
    pinned_download_and_extract(
        repository_ctx,
        url = url,
        sha256 = require_sha256(repository_ctx.attr.sha256, url),
        output = "material-fonts",
    )
    _write_material_fonts_build(repository_ctx)

def _write_material_fonts_build(repository_ctx):
    repository_ctx.file("BUILD.bazel", """# Generated by flutter/repositories.bzl
load("@rules_flutter//flutter:toolchain.bzl", "flutter_material_icons_toolchain")

exports_files(glob(["**"]), visibility = ["//visibility:public"])

flutter_material_icons_toolchain(
    name = "material_icons_toolchain",
    material_icons_font = "material-fonts/MaterialIcons-Regular.otf",
